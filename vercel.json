{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "templates/**,static/**"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py/$1"
    }
  ]
}

